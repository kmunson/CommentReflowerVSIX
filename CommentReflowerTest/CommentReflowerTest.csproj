<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>CommentReflowerTest</AssemblyName>
    <RootNamespace>CommentReflowerTest</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- AssemblyInfo.cs uses a wildcard version, which a deterministic build rejects. -->
    <Deterministic>false</Deterministic>
    <!-- The test reads ..\..\Input, so it has to run from bin\Debug or bin\Release. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefineConstants>$(DefineConstants);UNIT_TEST</DefineConstants>
    <!-- UNIT_TEST compiles out the ThreadHelper.ThrowIfNotOnUIThread() calls in
         CommentReflowerSharedLib, which still uses the EnvDTE interfaces that the mock
         editor objects implement, so the threading analyzer would flag every use of them. -->
    <NoWarn>$(NoWarn);VSTHRD010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK">
      <Version>17.14.40265</Version>
    </PackageReference>
  </ItemGroup>
  <Import Project="..\CommentReflowerSharedLib\CommentReflowerSharedLib.projitems" Label="Shared" />
</Project>
