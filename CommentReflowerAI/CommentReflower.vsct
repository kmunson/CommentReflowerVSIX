<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable"
	xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<Extern href="stdidcmd.h" />
	<Extern href="vsshlids.h" />

	<Commands package="guidCommentReflowerPkg">
		<Groups>
			<Group guid="guidCommentReflowerCmdSet" id="groupMenuTools" priority="0x0600">
				<Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
			</Group>
			<Group guid="guidCommentReflowerCmdSet" id="groupCtxtCodeWin" priority="0x0100">
				<Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
			</Group>
		</Groups>

		<Buttons>
			<Button guid="guidCommentReflowerCmdSet" id="cmdidReflowPoint" priority="0x0101" type="Button">
				<Parent guid="guidCommentReflowerCmdSet" id="groupMenuTools" />
				<CommandFlag>DefaultInvisible</CommandFlag>
				<CommandFlag>DynamicVisibility</CommandFlag>
				<Strings>
					<ButtonText>Reflow Comment at Cursor</ButtonText>
				</Strings>
			</Button>
			<Button guid="guidCommentReflowerCmdSet" id="cmdidReflowSelection" priority="0x0102"
			  type="Button">
				<Parent guid="guidCommentReflowerCmdSet" id="groupMenuTools" />
				<CommandFlag>DefaultInvisible</CommandFlag>
				<CommandFlag>DynamicVisibility</CommandFlag>
				<Strings>
					<ButtonText>Reflow All Comments in Selection</ButtonText>
				</Strings>
			</Button>
		</Buttons>
	</Commands>

	<!-- Also show the reflow commands in the code window's context menu. -->
	<CommandPlacements>
		<CommandPlacement guid="guidCommentReflowerCmdSet" id="cmdidReflowPoint" priority="0x0101">
			<Parent guid="guidCommentReflowerCmdSet" id="groupCtxtCodeWin" />
		</CommandPlacement>
		<CommandPlacement guid="guidCommentReflowerCmdSet" id="cmdidReflowSelection" priority="0x0102">
			<Parent guid="guidCommentReflowerCmdSet" id="groupCtxtCodeWin" />
		</CommandPlacement>
	</CommandPlacements>

	<Symbols>
		<GuidSymbol name="guidCommentReflowerPkg" value="{72013fe4-9734-4e6d-9903-7f3213491b37}" />
		<GuidSymbol name="guidCommentReflowerCmdSet" value="{b0b60bde-f731-40e3-8a6d-0750ad716ea0}">
			<IDSymbol name="groupMenuTools" value="0x1020" />
			<IDSymbol name="groupCtxtCodeWin" value="0x1021" />
			<IDSymbol name="cmdidReflowPoint" value="0x0101" />
			<IDSymbol name="cmdidReflowSelection" value="0x0102" />
		</GuidSymbol>
	</Symbols>

</CommandTable>